{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/osrm/Dockerfile",
    "watchPatterns": [
      "infra/osrm/**"
    ]
  },
  "deploy": {
    "startCommand": "osrm-routed --algorithm mld /data/switzerland-latest.osrm",
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    }
  }
}
