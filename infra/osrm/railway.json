{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/osrm/Dockerfile",
    "watchPatterns": ["infra/osrm/**"]
  },
  "deploy": {
    "startCommand": "osrm-routed --algorithm mld /data/switzerland-latest.osrm",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "region": "europe-west4"
  }
}
