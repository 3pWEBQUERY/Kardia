// Kardia – Prisma-Schema (Prisma ORM 7.10.x, PostgreSQL 16+)
// Geldbeträge in CHF als Int (ganze Franken), Zeiten in UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Erweiterungen pg_trgm und unaccent werden in der ersten Migration
// per CREATE EXTENSION angelegt (siehe migrations/0000_init_extensions).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum Locale {
  DE_CH
  FR_CH
  IT_CH
  EN
}

enum Profession {
  NURSE_HF_FH
  FAGE
  AGS
  NURSING_AID_SRK
  PHYSICIAN
  MPA
  PHYSIOTHERAPIST
  OCCUPATIONAL_THERAPIST
  SPEECH_THERAPIST
  MTRA
  BMA
  PARAMEDIC
  OR_TECHNICIAN
  MIDWIFE
}

enum Department {
  ICU
  EMERGENCY
  SURGERY
  INTERNAL_MEDICINE
  GERIATRICS
  PSYCHIATRY
  PEDIATRICS
  ONCOLOGY
  OPERATING_ROOM
  ANESTHESIA
  LONG_TERM_CARE
  HOME_CARE
  REHABILITATION
  MATERNITY
  RADIOLOGY
  LABORATORY
  PRACTICE
}

enum ShiftType {
  EARLY
  LATE
  NIGHT
  DAY_12H
  SPLIT
  WEEKDAYS_ONLY
}

enum RosterCode {
  F // Früh
  S // Spät
  N // Nacht
  T // Tag 12h
  X // frei
}

enum ChildcareType {
  NONE
  INTERNAL_DAYCARE
  ALLOWANCE
}

enum OrgVerification {
  PENDING
  VERIFIED
  REJECTED
  AGENCY_REVIEW
}

enum MemberRole {
  OWNER
  RECRUITER
  WARD_LEAD
  VIEWER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  NEW
  SCREENED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum RejectionReason {
  QUALIFICATION_MISSING
  POSITION_FILLED
  LANGUAGE
  AVAILABILITY
  OTHER
}

enum CredentialType {
  DIPLOMA
  RECOGNITION_SRK
  RECOGNITION_MEBEKO
  REGISTRY_ENTRY
  FURTHER_EDUCATION
  LANGUAGE_CERTIFICATE
}

enum CredentialStatus {
  SUBMITTED
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum Registry {
  MEDREG
  GESREG
  NAREG
}

enum OfferStatus {
  SENT
  INTERESTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ShiftStatus {
  OPEN
  BOOKED
  CANCELLED
  COMPLETED
}

enum PoolBookingMode {
  FIRST_CONFIRMS
  EMPLOYER_SELECTS
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileStatus {
  UPLOADING
  SCANNING
  READY
  REJECTED
}

enum AiFunction {
  JOB_STRUCTURING
  SEARCH_PARSING
  DOCUMENT_PRECHECK
  MODERATION
  TEAM_SUMMARY
  TRANSLATION
}

enum AiRunStatus {
  SUCCESS
  INVALID_OUTPUT
  TIMEOUT
  ERROR
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum PlanTier {
  PRAXIS
  INSTITUTION
  SPITALGRUPPE
}

// ─────────────────────── Identität & Auth ───────────────────────
// Tabellen für Sessions/Passkeys erzeugt Better Auth; hier nur die Fachdomäne.

// Better Auth nutzt diese Tabelle als "user"-Modell (name/image/updatedAt sind Pflichtfelder
// von Better Auth); Sessions, Konten, Passkeys usw. stehen weiter unten.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  name            String    @default("")
  image           String?
  locale          Locale    @default(DE_CH)
  isAdmin         Boolean   @default(false)
  lastActiveAt    DateTime  @default(now())
  /// Zustimmung zu AGB und Datenschutzerklärung (PRD 14.3) mit Version
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  candidate   CandidateProfile?
  memberships OrgMember[]
  pushSubs    PushSubscription[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
  passkeys    Passkey[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Arbeitgeber ─────────────────────────

model Organization {
  id                      String          @id @default(cuid())
  name                    String
  uid                     String          @unique // CHE-123.456.789
  verification            OrgVerification @default(PENDING)
  secoRegistryMatch       Boolean         @default(false)
  emailDomains            String[]
  logoFileId              String?         @unique
  plan                    PlanTier?
  stripeCustomerId        String?         @unique
  offerQuotaPerMonth      Int             @default(0)
  planValidUntil          DateTime?
  /// Stripe-Abo für Kundenportal und Lebenszyklus (Kündigung, Zahlungsausfall)
  stripeSubscriptionId    String?         @unique
  foundingPartner         Boolean         @default(false)
  /// Zustimmung zu den AGB für Arbeitgeber (PRD 14.3)
  employerTermsAcceptedAt DateTime?
  createdAt               DateTime        @default(now())

  logo      File?             @relation("OrgLogo", fields: [logoFileId], references: [id])
  members   OrgMember[]
  locations Location[]
  pools     FlexPool[]
  offers    Offer[]
  blockedBy CandidateBlock[]
  apiKeys   ApiKey[]
  webhooks  WebhookEndpoint[]
  feeds     JobFeed[]
  invites   InviteToken[]
}

model OrgMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  street         String
  postalCode     String
  city           String
  canton         String  @db.Char(2)
  lat            Float
  lng            Float
  hasParking     Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wards        Ward[]

  @@index([canton])
  @@index([lat, lng])
}

// Stationsprofil (Modul A) – trägt die Arbeitsbedingungen
model Ward {
  id                       String        @id @default(cuid())
  locationId               String
  name                     String
  department               Department
  salaryMinChf             Int // brutto/Jahr bei 100 %
  salaryMaxChf             Int
  thirteenthSalary         Boolean
  nightAllowanceChfHour    Int
  sundayAllowancePct       Int
  onCallChfDay             Int?
  shiftTypes               ShiftType[]
  rosterLeadWeeks          Int
  weekendsPerMonth         Float
  guaranteedWishDays       Int
  minWorkloadPct           Int
  maxWorkloadPct           Int
  minShiftsPerWeek         Int?
  patientsPerNurseDay      Float?
  patientsPerNurseNight    Float?
  skillMixHfFhPct          Int?
  skillMixFagePct          Int?
  skillMixAidPct           Int?
  onboardingWeeks          Int
  vacationWeeks            Int
  educationBudgetChf       Int?
  educationDays            Int?
  childcare                ChildcareType @default(NONE)
  childcareAllowanceChf    Int?
  collectiveAgreement      String // GAV-Name oder "kein GAV"
  rosterPattern            RosterCode[] // genau 28 Einträge, Validierung in Zod
  reentryFriendly          Boolean       @default(false)
  reentryOnboardingWeeks   Int?
  reentryAccompaniedShifts Int? // Modul H: begleitete Dienste
  reentryRefresher         Json? // Modul H: [{ provider, durationDays, costCoveredChf }]
  description              String?
  translations             Json? // KI-6: { "fr-CH": { description }, … }
  confirmedAt              DateTime // letzte Bestätigung durch Arbeitgeber
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  jobs              Job[]
  realityChecks     RealityCheck[]
  videos            WardVideo[]
  questions         TeamQuestion[]
  ambassadors       WardAmbassador[]
  verifiedEmployees VerifiedEmployee[]
  shifts            Shift[]
  benchmarks        WardBenchmark[]
  fieldComments     WardFieldComment[]

  @@index([department])
  @@index([salaryMinChf])
  @@index([rosterLeadWeeks])
  @@index([shiftTypes], type: Gin)
  @@index([confirmedAt])
}

model Job {
  id                          String                   @id @default(cuid())
  wardId                      String
  title                       String
  profession                  Profession
  workloadMinPct              Int
  workloadMaxPct              Int
  startDate                   DateTime?                @db.Date
  status                      JobStatus                @default(DRAFT)
  overrides                   Json? // überschriebene Ward-Felder
  allowsPendingRecog          Boolean                  @default(false) // Modul H
  // Modul F – ärztliche Weiterbildung
  specialtyTitle              String?
  trainingCategory            String?
  maxCreditableYears          Float?
  weeklyHours                 Int?
  structuredTrainingHoursWeek Int?
  rotations                   String[]                 @default([])
  assistantPositions          Int?
  // Abrechnung Einzelinserat und Feed-Import (R2)
  paidUntil                   DateTime?
  feedId                      String?
  externalRef                 String?
  sourceHash                  String?
  // Volltextsuche (per Migration als generierte Spalte + GIN-Index gepflegt)
  searchVector                Unsupported("tsvector")?
  publishedAt                 DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  ward         Ward          @relation(fields: [wardId], references: [id], onDelete: Cascade)
  feed         JobFeed?      @relation(fields: [feedId], references: [id], onDelete: SetNull)
  applications Application[]
  offers       Offer[]
  savedBy      SavedJob[]

  @@unique([feedId, externalRef])
  @@index([status, profession])
  @@index([wardId, status])
  @@index([publishedAt])
}

// ───────────────────────── Fachpersonen ─────────────────────────

model CandidateProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  firstName          String
  lastName           String
  phone              String?
  homeLat            Float?
  homeLng            Float?
  homeDistrict       String? // für anonymes Marktplatz-Profil
  profession         Profession
  yearsExperience    Int        @default(0)
  workAuthorizedCh   Boolean? // nur Ja/Nein, kein Status
  // Modul E – anonymes Marktplatz-Profil
  marketplaceActive  Boolean    @default(false)
  desiredWorkloadPct Int?
  earliestStart      DateTime?  @db.Date
  mustConditions     Json? // gleiches Schema wie Suchfilter
  createdAt          DateTime   @default(now())

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials   Credential[]
  experiences   Experience[]
  languages     LanguageSkill[]
  applications  Application[]
  offers        Offer[]
  savedJobs     SavedJob[]
  savedSearches SavedSearch[]
  blocks        CandidateBlock[]
  poolMembers   PoolMember[]
  trainingYears TrainingProgress[]
  recognition   RecognitionProgress[]
}

model Experience {
  id          String     @id @default(cuid())
  candidateId String
  department  Department
  years       Float

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model LanguageSkill {
  id          String @id @default(cuid())
  candidateId String
  language    String @db.Char(2) // ISO 639-1
  level       String @db.VarChar(2) // A1–C2

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, language])
}

model TrainingProgress {
  id             String @id @default(cuid())
  candidateId    String
  specialtyTitle String
  area           String
  yearsCompleted Float

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// Qualifikations-Pass (Modul D)
model Credential {
  id             String           @id @default(cuid())
  candidateId    String
  type           CredentialType
  title          String
  issuer         String?
  issuedAt       DateTime?        @db.Date
  validUntil     DateTime?        @db.Date
  registry       Registry?
  registryNumber String?
  status         CredentialStatus @default(SUBMITTED)
  rejectReason   String?
  reviewedById   String?
  reviewedAt     DateTime?
  fileId         String?          @unique
  createdAt      DateTime         @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  file      File?            @relation("CredentialFile", fields: [fileId], references: [id])

  @@index([status])
}

model Application {
  id              String            @id @default(cuid())
  jobId           String
  candidateId     String
  status          ApplicationStatus @default(NEW)
  message         String?           @db.VarChar(500)
  documentsShared Boolean           @default(false)
  /// Ein-Klick-Bewerbung mit dem Qualifikations-Pass (KPI "Ein-Klick-Quote")
  viaPass         Boolean           @default(false)
  rejectionReason RejectionReason?
  statusChangedAt DateTime          @default(now())
  createdAt       DateTime          @default(now())

  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([jobId, candidateId])
  @@index([status])
  @@index([candidateId])
}

model Message {
  id            String    @id @default(cuid())
  applicationId String
  senderUserId  String
  body          String
  createdAt     DateTime  @default(now())
  /// Gelesen-Markierung durch die Gegenseite (PRD 13.2, Hintergrund-Sync)
  readAt        DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model SavedJob {
  candidateId String
  jobId       String
  createdAt   DateTime @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobId])
}

model SavedSearch {
  id          String         @id @default(cuid())
  candidateId String
  name        String
  filters     Json
  frequency   AlertFrequency @default(DAILY)
  lastSentAt  DateTime?

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─────────────────── Umgekehrter Marktplatz (E) ───────────────────

model Offer {
  id             String      @id @default(cuid())
  organizationId String
  candidateId    String
  jobId          String
  salaryChf      Int
  workloadPct    Int
  startDate      DateTime    @db.Date
  note           String?     @db.VarChar(600)
  status         OfferStatus @default(SENT)
  declineReason  String?
  expiresAt      DateTime
  createdAt      DateTime    @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([candidateId, status])
}

model CandidateBlock {
  candidateId    String
  organizationId String

  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([candidateId, organizationId])
}

// ───────────────────────── Flex-Pool (C) ─────────────────────────

model FlexPool {
  id                  String          @id @default(cuid())
  organizationId      String
  name                String
  bookingMode         PoolBookingMode @default(FIRST_CONFIRMS)
  cancelDeadlineHours Int             @default(48)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      PoolMember[]
  shifts       Shift[]
}

model PoolMember {
  poolId      String
  candidateId String
  joinedAt    DateTime @default(now())

  pool      FlexPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([poolId, candidateId])
  @@index([candidateId])
}

model Shift {
  id                  String      @id @default(cuid())
  poolId              String
  wardId              String
  startsAt            DateTime
  endsAt              DateTime
  code                RosterCode
  hourlyRateChf       Int
  requirements        String?
  status              ShiftStatus @default(OPEN)
  bookedByCandidateId String?
  bookedAt            DateTime?

  pool      FlexPool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  ward      Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  interests ShiftInterest[]

  @@index([poolId, status, startsAt])
  @@index([bookedByCandidateId])
}

// ──────────────── Team-Einblicke & Realitäts-Check (G) ────────────────

model VerifiedEmployee {
  id         String   @id @default(cuid())
  wardId     String
  userId     String
  method     String // EMAIL_DOMAIN | EMPLOYER_INVITE
  verifiedAt DateTime @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, userId])
}

model RealityCheck {
  id            String   @id @default(cuid())
  wardId        String
  field         String // Feldname aus Ward
  agrees        Boolean
  proposedValue String?
  comment       String?  @db.VarChar(400)
  // nur Hash, damit keine Zuordnung zur Person gespeichert wird
  voterHash     String
  createdAt     DateTime @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, field, voterHash])
}

model WardVideo {
  id          String           @id @default(cuid())
  wardId      String
  fileId      String           @unique
  captionsId  String           @unique
  posterId    String?          @unique
  durationSec Int
  moderation  ModerationStatus @default(PENDING)

  ward     Ward  @relation(fields: [wardId], references: [id], onDelete: Cascade)
  file     File  @relation("VideoFile", fields: [fileId], references: [id])
  captions File  @relation("VideoCaptions", fields: [captionsId], references: [id])
  poster   File? @relation("VideoPoster", fields: [posterId], references: [id])
}

model WardAmbassador {
  wardId String
  userId String

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([wardId, userId])
}

model TeamQuestion {
  id         String           @id @default(cuid())
  wardId     String
  askedById  String
  body       String           @db.VarChar(500)
  answer     String?          @db.VarChar(1500)
  answeredAt DateTime?
  moderation ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
}

model WardBenchmark {
  id          String   @id @default(cuid())
  wardId      String
  field       String
  wardValue   Float
  medianValue Float
  peerCount   Int
  computedAt  DateTime @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, field])
}

// ─────────────────────────── Infrastruktur ───────────────────────────

model File {
  id        String     @id @default(cuid())
  bucketKey String     @unique // z. B. pass/<cuid>.pdf
  mimeType  String
  sizeBytes Int
  sha256    String
  status    FileStatus @default(UPLOADING)
  ownerId   String
  createdAt DateTime   @default(now())

  orgLogo       Organization? @relation("OrgLogo")
  credential    Credential?   @relation("CredentialFile")
  videoFile     WardVideo?    @relation("VideoFile")
  videoCaptions WardVideo?    @relation("VideoCaptions")
  videoPoster   WardVideo?    @relation("VideoPoster")
}

model CommuteCache {
  originGeohash String // Geohash Präzision 7 (~150 m)
  wardId        String
  mode          String // PT | CAR
  minutes       Int
  computedAt    DateTime @default(now())

  @@id([originGeohash, wardId, mode])
}

model AiRun {
  id           String      @id @default(cuid())
  function     AiFunction
  model        String      @default("claude-haiku-5-5")
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal     @db.Decimal(10, 6)
  durationMs   Int
  status       AiRunStatus
  inputHash    String
  rawInput     String? // nach 30 Tagen per Job geleert
  rawOutput    Json?
  orgId        String?
  createdAt    DateTime    @default(now())

  @@index([function, createdAt])
  @@index([orgId, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  name      String // z. B. job.published, application.created
  userId    String?
  orgId     String?
  entityId  String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model RecognitionGuide {
  id               String     @id @default(cuid())
  originCountry    String     @db.Char(2)
  targetProfession Profession
  authority        String // SRK | MEBEKO | …
  steps            Json
  reviewedAt       DateTime   @db.Date

  progress RecognitionProgress[]

  @@unique([originCountry, targetProfession])
}

// ─────────────── Ergänzungen über das PRD-Kernschema hinaus ───────────────
// Siehe docs/adr/0002-schema-ergaenzungen.md: Better-Auth-Tabellen, R2-Tabellen
// aus Abschnitt 12 (API-Schlüssel, Webhooks, RateLimit, Feed-Import) und kleine
// Hilfstabellen für Einladungen, Meldungen und Arbeitgeber-Kommentare.

// Better Auth: Sitzungen, Konten (E-Mail-Link, SSO), Verifikations-Token, Passkeys
model Session {
  id         String   @id
  userId     String
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  authMethod String? // passkey | magic-link | sso – Admins nur mit Passkey (PRD 14.2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
}

model SsoProvider {
  id             String  @id
  issuer         String
  domain         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  providerId     String  @unique
  organizationId String?
}

// API-Schlüssel pro Organisation (Abschnitt 12.1), nur als SHA-256-Hash
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String // erste 8 Zeichen zur Anzeige
  keyHash        String    @unique
  scopes         String[] // jobs:write, applications:read
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Webhooks (Abschnitt 12.2)
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String // verschlüsselt (AES-256-GCM)
  events         String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  attempts    Int       @default(0)
  lastStatus  Int?
  deliveredAt DateTime?
  nextAttempt DateTime?
  createdAt   DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

// Token-Bucket für Rate Limits (Abschnitt 12.1)
model RateLimit {
  key       String   @id // z. B. ip:1.2.3.4 oder org:<id>
  tokens    Float
  updatedAt DateTime @default(now())
}

// Feed-Import (Abschnitt 12.3, R2)
model JobFeed {
  id             String    @id @default(cuid())
  organizationId String
  wardId         String // Standard-Station für neue Entwürfe
  url            String
  format         String // XML | JSON
  lastHash       String?
  lastRunAt      DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]
}

// Einladungen: Team-Mitglied, verifizierte:r Mitarbeitende:r (G), Flex-Pool (C)
model InviteToken {
  id             String      @id @default(cuid())
  kind           String // ORG_MEMBER | EMPLOYEE | POOL
  organizationId String
  email          String
  role           MemberRole?
  wardId         String?
  poolId         String?
  tokenHash      String      @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
}

// Gegendarstellung des Arbeitgebers zu Realitäts-Check-Werten (AK-G2)
model WardFieldComment {
  id        String   @id @default(cuid())
  wardId    String
  field     String
  body      String   @db.VarChar(600)
  authorId  String
  createdAt DateTime @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, field])
}

// Gemeldete Inhalte für die Moderation (Admin-Konsole)
model ContentReport {
  id         String           @id @default(cuid())
  entity     String // TeamQuestion | RealityCheck | WardVideo
  entityId   String
  reason     String           @db.VarChar(400)
  reporterId String?
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@index([status, createdAt])
}

// Eigener Fortschritt im Anerkennungs-Tracker (Modul H)
model RecognitionProgress {
  candidateId    String
  guideId        String
  completedSteps String[]
  updatedAt      DateTime @updatedAt

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  guide     RecognitionGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([candidateId, guideId])
}

// Flex-Pool im Modus "Arbeitgeber wählt aus": Interessensbekundungen pro Schicht
model ShiftInterest {
  shiftId     String
  candidateId String
  createdAt   DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([shiftId, candidateId])
}
