{
  "extends": "@kardia/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/app/.well-known/**/*.ts", ".next/types/**/*.ts", "next.config.ts", "test/**/*.ts", "e2e/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
