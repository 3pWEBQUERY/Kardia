# Lokale Entwicklung. In Railway kommen alle Werte aus Variablen/Referenzen (PRD 10.2).
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://kardia:kardia@localhost:5432/kardia

# Better Auth
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-xxxxxxxxxxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
PASSKEY_RP_ID=localhost

# Feldverschlüsselung (kid:base64-32-Byte, erster Schlüssel aktiv) und Hash-Secret Realitäts-Check
FIELD_ENCRYPTION_KEYS=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VOTER_HASH_SECRET=change-me

# Railway Bucket (S3-kompatibel)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=kardia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# KI (Claude Haiku 5.5)
ANTHROPIC_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRAXIS=
STRIPE_PRICE_INSTITUTION=
STRIPE_PRICE_SPITALGRUPPE=
STRIPE_PRICE_SINGLE_LISTING=

# Rechnung mit QR-Einzahlungsschein
BILLING_IBAN=CH4431999123000889012
BILLING_CREDITOR_NAME=Kardia AG
BILLING_CREDITOR_ADDRESS=Musterstrasse 1
BILLING_CREDITOR_ZIP=8000
BILLING_CREDITOR_CITY=Zürich

# Monitoring (EU-Datenregion)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Karten (swisstopo Vektorkacheln, frei nutzbar)
NEXT_PUBLIC_MAP_STYLE=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json

# Nur Entwicklung: Admin-Konsole auch mit E-Mail-Link-Sitzung erlauben (in Produktion wirkungslos)
DEV_ADMIN_MAGIC_LINK=0

# Release-Schalter (R1 ohne Marktplatz und Flex-Pool): false blendet Navigation,
# Seiten, Server Actions und API-Endpunkte der Funktion aus (404).
FEATURE_MARKETPLACE=true
FEATURE_FLEXPOOL=true
