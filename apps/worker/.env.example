# Worker – alle Werte in Railway als Variablen/Referenzen (PRD 10.2).
DATABASE_URL=postgresql://kardia:kardia@localhost:5432/kardia
APP_ORIGIN=http://localhost:3000
WORKER_CONCURRENCY=4
FIELD_ENCRYPTION_KEYS=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VOTER_HASH_SECRET=change-me
ANTHROPIC_API_KEY=

# Bucket + Replika
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kardia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REPLICA_BUCKET=
S3_REPLICA_ENDPOINT=
S3_REPLICA_ACCESS_KEY_ID=
S3_REPLICA_SECRET_ACCESS_KEY=
# 32 Byte base64 – Verschlüsselung der pg_dump-Backups
BACKUP_ENCRYPTION_KEY=

# ClamAV (im Container gestartet), OSRM (eigener Railway-Dienst), ÖV (opentransportdata.swiss)
CLAMAV_HOST=
CLAMAV_PORT=3310
OSRM_URL=http://osrm.railway.internal:5000
OJP_URL=https://api.opentransportdata.swiss/ojp20
OJP_API_KEY=

# E-Mail (SES eu-central-1); MAIL_TRANSPORT=log protokolliert nur (Standard ausserhalb Produktion)
MAIL_TRANSPORT=log
SES_REGION=eu-central-1
MAIL_FROM=Kardia <noreply@kardia.ch>
OPS_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kardia.ch

# Organisationsprüfung: UID-Register (BFS, SOAP) und gespiegeltes SECO-Verzeichnis (JSON)
UID_REGISTER_URL=https://www.uid-wse.admin.ch/V5.0/PublicServices.svc
SECO_REGISTRY_URL=

SENTRY_DSN=
