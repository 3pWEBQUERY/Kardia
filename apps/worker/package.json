{
  "name": "@kardia/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker-Dienst: pg-boss-Jobs für Dateien, Pendelzeit, KI, E-Mail, Push, Webhooks, Aufbewahrung, Benchmarks, Backups.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "node build.mjs",
