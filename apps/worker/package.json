    "@kardia/db": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@sentry/node": "^11.8.0",
    "fast-xml-parser": "^5.11.2",
    "nodemailer": "^7.0.13",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kardia/config": "workspace:*",
    "@types/node": "^22.19.0",
